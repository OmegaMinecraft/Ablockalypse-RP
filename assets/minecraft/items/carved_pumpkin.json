{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:has_component",
    "component": "minecraft:custom_name",
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_name",
      "cases": [
        {
          "when": "1",
          "model": {
            "type": "minecraft:model",
            "model": "item/carved_pumpkin/santa_hat"
          }
        },
        {
          "when": "2",
          "model": {
            "type": "minecraft:model",
            "model": "item/carved_pumpkin/candy_cane_hat"
          }
        },
        {
          "when": "3",
          "model": {
            "type": "minecraft:model",
            "model": "item/carved_pumpkin/gift_hat"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:block/carved_pumpkin"
      }
    },
    "on_false": {
      "type": "minecraft:model",
      "model": "item/carved_pumpkin"
    }
  }
}